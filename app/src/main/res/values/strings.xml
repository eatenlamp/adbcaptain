    <string name="term_help_title">= ADB Captain Help =</string>
    <string name="term_help_intro">This terminal runs real ADB commands through Shizuku — no root needed. Just type a command and press send.\n\n</string>
    <string name="term_help_commands">Common commands:\n  pm list packages -3             user apps\n  pm path &lt;pkg&gt;                   APK path\n  pm clear &lt;pkg&gt;                  wipe app data\n  am force-stop &lt;pkg&gt;             stop an app\n  getprop ro.product.model        device model\n  wm size                         screen size\n  dumpsys battery                 battery info\n  settings get global adb_enabled check ADB\n  screencap -p /sdcard/s.png      screenshot\n  input keyevent KEYCODE_HOME     press Home\n  logcat -d -t 100                last 100 log lines\n\n</string>
    <string name="term_help_features">Other screens:\n  Apps     manage and export apps, batch actions\n  Devices  switches, battery, reboot, diagnostics\n  Monitor  live CPU / RAM / processes\n  Logcat   live system logs\n  Sideload APK install, record screen, macros\n  Files    file manager\n\n</string>
    <string name="term_help_tips">Tips:\n  type help anytime to see this text\n  tap the clock icon to pick a past command\n  history is saved locally (see Settings)</string>

