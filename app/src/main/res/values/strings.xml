    <!-- Help / Tutorial -->
    <string name="help_title">How it works</string>
    <string name="help_back">Back</string>
    <string name="help_intro_title">Welcome to ADB Captain</string>
    <string name="help_intro_body">ADB Captain brings the Android Debug Bridge to your phone - no computer and no root required. Everything runs through the Shizuku service.</string>
    <string name="help_shizuku_title">What is Shizuku?</string>
    <string name="help_shizuku_body">Shizuku lets this app run shell commands as ADB. To use ADB Captain: 1) install Shizuku from the Play Store, 2) start its service, 3) open ADB Captain. If Shizuku is off, you will see a setup screen.</string>
    <string name="help_terminal_title">Terminal</string>
    <string name="help_terminal_body">Run any ADB command (pm, am, dumpsys, settings, input...). Use the quick chips to launch common commands. Your command history is saved locally (toggle in Settings).</string>
    <string name="help_autocomplete_title">What does auto-complete do?</string>
    <string name="help_autocomplete_body">While you type in the Terminal, ADB Captain suggests commands from your history that start with what you typed. Tap a suggestion to fill it in. Turn it on/off in Settings - Auto-complete.</string>
    <string name="help_apps_title">Apps</string>
    <string name="help_apps_body">Browse every installed app with search and User/System filters. Each app has a safety badge (green = safe to delete, red = critical). Tap the ... button or long-press a card for actions: force stop, clear data, disable/enable, uninstall.</string>
    <string name="help_devices_title">Devices</string>
    <string name="help_devices_body">Shows your phone info: model, Android version, battery. Take a screenshot with one tap, or reboot with confirmation.</string>
    <string name="help_logcat_title">Logcat</string>
    <string name="help_logcat_body">Watch system logs live. Filter by level (V/D/I/W/E/F) or search text, pause the stream, and tap any entry to copy it. The list auto-follows only while you are at the bottom.</string>
    <string name="help_sideload_title">Sideload &amp; Tools</string>
    <string name="help_sideload_body">Install APK files from storage, record the screen, control Wi-Fi/Bluetooth/airplane mode and volume, type text, and open links. The floating overlay button gives one-tap screenshots and screen recording from any app.</string>
    <string name="help_safety_title">Safety</string>
    <string name="help_safety_body">These are real system commands. Reboot, uninstall, disable and clear-data are powerful actions - use them carefully. You are responsible for the changes you make.</string>
